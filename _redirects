# www to non-www
https://www.aio-medicals.com/* https://aio-medicals.com/:splat 301!

# Serve directory index pages directly (must come first to prevent loops)
/tests/ /tests/index.html 200
/blog/ /blog/index.html 200

# Canonical redirects: strip .html and add trailing slash to directories
/index.html / 301!
/blog /blog/ 301
/blog/index.html /blog/ 301!
/tests /tests/ 301
/tests/index.html /tests/ 301!
/blog/*.html /blog/:splat 301!
/tests/*.html /tests/:splat 301!
/*.html /:splat 301!

# Serve extensionless URLs by rewriting to .html files
/sean-willers-blood-testing /sean-willers-blood-testing.html 200
/blog/* /blog/:splat.html 200
/tests/* /tests/:splat.html 200